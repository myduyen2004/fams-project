# ========================================
# DATABASE CONFIGURATION
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=fams_db
POSTGRES_AI_DB=fams_ai_db

# ========================================
# BACKEND CONFIGURATION
# ========================================
# JWT Secret Key (Required for Login - 401 Error if missing)
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-please
JWT_EXPIRATION=86400000

# Email Service (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ========================================
# AI SERVICE CONFIGURATION
# ========================================
# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# AI Service Settings
SECRET_KEY=ai-service-secret-key
BACKEND_API_URL=http://backend:8080/api