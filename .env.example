# ========================================
# DATABASE CONFIGURATION
# ========================================
# Username/Password cho PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Database Names
POSTGRES_DB=fams_db
POSTGRES_AI_DB=fams_ai_db

# ========================================
# BACKEND CONFIGURATION
# ========================================
# JWT Secret Key (QUAN TRỌNG: Cần thay đổi khi deploy)
# Nên dùng chuỗi ngẫu nhiên dài (ít nhất 32 ký tự)
JWT_SECRET=fams-super-secret-key-minimum-256-bits-for-hs256-algorithm-change-this-in-production
JWT_EXPIRATION=86400000        # 24 hours (ms)
JWT_REFRESH_EXPIRATION=604800000 # 7 days (ms)

# Email Service (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ========================================
# AI SERVICE CONFIGURATION
# ========================================
# Redis Configuration (Mặc định dùng service name 'redis' trong Docker)
REDIS_HOST=redis
REDIS_PORT=6379

# Backend API URL (Để AI Service gọi lại Backend)
BACKEND_API_URL=http://backend:8080/api
