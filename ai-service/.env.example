# Application Settings
APP_NAME=FAMS-AI-Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
PORT=5000
HOST=0.0.0.0

# API Settings
API_V1_PREFIX=/api/v1
API_TITLE=FAMS AI Service API
API_DESCRIPTION=Face Recognition and Liveness Detection Service

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fams_ai_db
DB_USER=postgres
DB_PASSWORD=your_password
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_EXPIRY=3600

# Face Recognition Settings
FACE_RECOGNITION_MODEL=facenet  # facenet, arcface
FACE_DETECTION_BACKEND=mtcnn    # mtcnn, opencv, ssd, dlib
FACE_RECOGNITION_THRESHOLD=0.6
MIN_FACE_SIZE=80
EMBEDDING_SIZE=512

# Liveness Detection Settings
LIVENESS_ENABLED=True
LIVENESS_MODEL=anti_spoofing
LIVENESS_THRESHOLD=0.7
MAX_FRAME_ANALYSIS=5

# Image Processing
MAX_IMAGE_SIZE=5242880  # 5MB in bytes
ALLOWED_IMAGE_FORMATS=["jpg", "jpeg", "png"]
IMAGE_QUALITY=95
FACE_IMAGE_SIZE=160

# ML Models Path
PRETRAINED_MODELS_PATH=./ml_models/pretrained
TRAINED_MODELS_PATH=./ml_models/trained
FACENET_MODEL_PATH=./ml_models/pretrained/facenet.pth
ARCFACE_MODEL_PATH=./ml_models/pretrained/arcface.onnx
LIVENESS_MODEL_PATH=./ml_models/pretrained/anti_spoofing.pb

# Data Storage
FACES_DATA_PATH=./data/faces
TEMP_DATA_PATH=./data/temp
LOGS_PATH=./data/logs

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backend Service Integration
BACKEND_API_URL=http://localhost:8080/api
BACKEND_API_KEY=your-backend-api-key

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_FILE=app.log

# Performance
WORKERS=4
THREADS=2
TIMEOUT=300
MAX_REQUESTS=1000

# GPU Settings
USE_GPU=False
GPU_DEVICE=0
GPU_MEMORY_FRACTION=0.5

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60