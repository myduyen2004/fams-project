# Template environment file for Staging
# Copy this to .env.staging on EC2 and fill in the values

# Neon Staging Database
NEON_STAGING_DB_URL=postgresql://[user]:[password]@[host]/[database]?sslmode=require
NEON_STAGING_DB_USER=your_staging_db_user
NEON_STAGING_DB_PASSWORD=your_staging_db_password

# CORS (optional, will use default if not set)
# CORS_ALLOWED_ORIGINS=https://staging.fams-edu.online,https://fams-staging.vercel.app
